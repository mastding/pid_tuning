# ============ 服务端口配置 ============
# 后端API服务端口
BACKEND_PORT=4443
BACKEND_HOST=0.0.0.0

# 前端服务端口
FRONTEND_PORT=5873
FRONTEND_HOST=127.0.0.1

# ============ LLM 模型配置 ============
# 模型名称
MODEL=qwen-plus

# 模型API URL (例如: https://dashscope.aliyuncs.com/compatible-mode/v1)
MODEL_API_URL=

# 模型API密钥
MODEL_API_KEY=

# 模型连接超时时间（秒）
MODEL_TIMEOUT_CONNECT=20

# 模型读取超时时间（秒）
MODEL_TIMEOUT_READ=120

# 模型写入超时时间（秒）
MODEL_TIMEOUT_WRITE=60

# 模型连接池超时时间（秒）
MODEL_TIMEOUT_POOL=30

# 是否启用LLM编排 (1=启用, 0=禁用)
ENABLE_LLM_ORCHESTRATION=1

# ============ 外部集成配置 ============
# 历史数据API地址
HISTORY_DATA_API_URL=http://holli-pid-agent.hollysys-project.sit-cloud.ieccloud.hollicube.com/api/agent/history-data-raw

# 知识图谱API地址
KNOWLEDGE_GRAPH_API_URL=http://graphrag.dicp.sixseven.ltd:5924/api/query

# 知识图谱ID
KNOWLEDGE_GRAPH_ID=build_20260317_003858

# 是否启用知识专家 (1=启用, 0=禁用)
ENABLE_KNOWLEDGE_EXPERT=1

# 是否启用经验沉淀和检索 (1=启用, 0=禁用)
ENABLE_EXPERIENCE_DISTILLATION=1
